JWT_SECRET=change-me-openssl-rand-hex-32
# Нужен только для vite dev-сервера: контейнерный фронт ходит через свой nginx.
CORS_ORIGINS=http://localhost:5173
# Для запуска api на хосте через cargo run, минуя контейнер.
DATABASE_URL=postgres://leser:leser@localhost:5432/leser
# Необязательный. Без него поиск по GitHub выключается, остальные источники работают.
# Нужен обычный fine-grained токен без прав: /search/code просто требует аутентификации.
GITHUB_TOKEN=
